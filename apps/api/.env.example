# ─── Database ─────────────────────────────────────
DATABASE_URL="postgresql://cleancity:cleancity_dev@localhost:5433/cleancity?schema=public"

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_me
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Cloudinary ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Maps (server-side geocoding) ──────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Resend (email) ──────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@cleancity.app

# ─── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Server ──────────────────────────────────────
PORT=4000
